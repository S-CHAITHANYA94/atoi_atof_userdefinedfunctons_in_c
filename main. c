#include <stdio.h>
#include "convert.h"
int main()
{
    char str[100];
    int i = 0, c = 0;
    printf("Enter a string:\n");
    scanf("%[^\n]", str);
    while (str[i])
    {
        if (str[i] == '.')
        {
            c++;
            break;
        }
        i++;
    }
    if (c == 0)
        printf("%d\n", my_atoi(str));
    else
        printf("%lf\n", my_atof(str));
    return 0;
}