#include <stdio.h>
double my_atof(char *str)
{
    int i = 0, r, c = 0, check = 1;
    double num = 0.0, div = 10.0;
    while (str[i] == ' ' || str[i]=='"')
        i++;
        if (str[i] == '-')
     {
       check = -1;
        i++;
    }
    for (; str[i]; i++)
    {
        if (str[i] >= '0' && str[i] <= '9')
        {
            r = str[i] - '0';

            if (c == 0)
                num = num * 10 + r;
            else
            {
                num = num + r / div;
                div = div * 10;
            }
        }
        else if (str[i] == '.' && c == 0)
            c++;
        else
            break;
    }
    return num * check;
}
