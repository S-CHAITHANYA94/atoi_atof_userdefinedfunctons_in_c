#include "convert.h" 
int my_atoi(char *str)
{
    int i = 0, num = 0, r, c = 1;
    while (str[i] == ' ')
        i++;
        if (str[i] == '-')
     {
       c = -1;
        i++;
    }
    for (; str[i]; i++)
    {
        if (str[i] >= '0' && str[i] <= '9')
        {
            r = str[i] - '0';
            num = num * 10 + r;
        }
        else
            break;
    }
    return num * c;
}